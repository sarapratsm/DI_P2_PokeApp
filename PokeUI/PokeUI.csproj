<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Remove="Imatges\avatar.ico" />
    <None Remove="Imatges\Ball-Pokedex.png" />
    <None Remove="Imatges\pokeball.png" />
    <None Remove="Imatges\Pokedex.png" />
    <None Remove="Imatges\Pokeicon.ico" />
    <None Remove="Imatges\TheAmazingPokedex %281%29.png" />
    <None Remove="Imatges\TheAmazingPokedex %282%29.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Imatges\avatar.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Imatges\Pokeicon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DependencyPropertyGenerator" Version="1.5.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="DotNetKit.Wpf.AutoCompleteComboBox" Version="2.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.22" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Imatges\Ball-Pokedex.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Imatges\pokeball.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Imatges\Pokedex.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Imatges\TheAmazingPokedex (1).png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <SplashScreen Include="Imatges\TheAmazingPokedex (2).png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </SplashScreen>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PokeData\PokeData.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
