<UserControl x:Class="PokeUI.UserControls.Evolutions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             x:Name="Evos"
             d:DesignHeight="300" d:DesignWidth="800">

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">

            <ItemsControl ItemsSource="{Binding ElementName=Evos, Path=EvolutionStages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Grid Visibility="{Binding ArrowVisibility}" Margin="5,0" VerticalAlignment="Center">
                                <Polygon Points="0,10 20,10 20,0 40,20 20,40 20,30 0,30"
                                         Fill="#1E7536" Stretch="Uniform" Width="30" Height="30"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Pokemons}" MaxHeight="600" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Vertical" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <StackPanel Margin="5,10" Cursor="Hand" VerticalAlignment="Center">

                                            <Grid Width="90" Height="90">
                                                <Ellipse Fill="White">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="10" Color="#1E7536" Opacity="0.25" ShadowDepth="2"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>

                                                <Image Source="{Binding PokImage}" Margin="8">
                                                    <Image.Clip>
                                                        <EllipseGeometry Center="37,37" RadiusX="37" RadiusY="37"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Grid>

                                            <StackPanel Margin="0,5,0,0">
                                                <TextBlock Text="{Binding PokName}" 
                               HorizontalAlignment="Center" 
                               FontWeight="Bold" 
                               FontSize="12"
                               Foreground="#333"
                               />

                                                <TextBlock Text="{Binding PokId, StringFormat='#{0:000}'}" 
                               HorizontalAlignment="Center" 
                               FontSize="10" 
                               Foreground="Gray"/>
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding PokemonTypes}" Margin="0,4,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Type.Color}" CornerRadius="3" Margin="1" Padding="4,1">
                                                            <TextBlock Text="{Binding Type.TypeName}" Foreground="White" FontWeight="Bold" FontSize="8" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>