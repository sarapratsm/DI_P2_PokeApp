<UserControl x:Class="PokeUI.UserControls.Evolutions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             x:Name="Evos"
             d:DesignHeight="300" d:DesignWidth="800">

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly">

            <ItemsControl ItemsSource="{Binding ElementName=Evos, Path=EvolutionStages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                            <Grid Visibility="{Binding ArrowVisibility}" Margin="10,0" VerticalAlignment="Center">
                                <Polygon Points="0,10 20,10 20,0 40,20 20,40 20,30 0,30"
                                         Fill="#1E7536" 
                                         Stretch="Uniform"
                                         Width="40" Height="40"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Pokemons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" VerticalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>

                                        <Border Background="White" CornerRadius="100" Margin="15" Padding="10" Cursor="Hand">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" Color="Gray" Opacity="0.2" ShadowDepth="2"/>
                                            </Border.Effect>

                                            <StackPanel HorizontalAlignment="Center">

                                                <TextBlock Text="{Binding PokId, StringFormat='#{0:000}'}" 
                                                           HorizontalAlignment="Center" 
                                                           Foreground="#1E7536" 
                                                           FontWeight="Bold" 
                                                           FontSize="12"/>

                                                <TextBlock Text="{Binding PokName}" 
                                                           HorizontalAlignment="Center" 
                                                           FontWeight="Bold" 
                                                           FontSize="14"
                                                           Margin="0,0,0,5"/>

                                                <Grid Width="100" Height="100">
                                                    <Ellipse Fill="#F5F5F5"/>
                                                    <Image Source="{Binding PokImage}" Margin="5"/>
                                                </Grid>

                                                <ItemsControl ItemsSource="{Binding PokemonTypes}" Margin="0,10,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding Type.Color}" 
                                                                    CornerRadius="3" 
                                                                    Margin="2" 
                                                                    Padding="8,2"
                                                                    MinWidth="40">
                                                                <TextBlock Text="{Binding Type.TypeName}" 
                                                                           Foreground="White" 
                                                                           FontWeight="Bold" 
                                                                           FontSize="10" 
                                                                           HorizontalAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                            </StackPanel>
                                        </Border>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>