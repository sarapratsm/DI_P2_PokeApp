<UserControl x:Class="PokeUI.UserControls.DamageModifiers"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PokeUI.UserControls"
             mc:Ignorable="d" 
             x:Name="Root"
             Background="White"
             d:DesignHeight="50" d:DesignWidth="100">
    <Border BorderBrush="Black" BorderThickness="1">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock x:Name="lblModificador" Text="{Binding ElementName=Root, Path=MultiplierText, FallbackValue=x2}" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Top" 
                       Foreground="Black"
                   Margin="5"/>

            <ListBox x:Name="lsbTipus" Grid.Column="1"
                     ItemsSource="{Binding ElementName=Root, Path=TypeList}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="3" Columns="2"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Black" 
                            CornerRadius="3" 
                            Margin="0,0,5,5" 
                            Padding="10,4">
                            <TextBlock Text="{Binding TypeName}" 
                                   Foreground="{Binding Color}" 
                                   FontWeight="SemiBold" 
                                   FontSize="12"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            
    </Grid>
    </Border>
</UserControl>
