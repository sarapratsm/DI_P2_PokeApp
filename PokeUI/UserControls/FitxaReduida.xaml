<UserControl x:Class="PokeUI.UserControls.FitxaReduida"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PokeUI.UserControls"
             x:Name="Fitxa"
             mc:Ignorable="d" 
             Background="White"
             Loaded="Fitxa_Loaded"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" 
               Source="{Binding ElementName=Fitxa, Path=ThePokemon.PokImage}"               
               Width="60" Height="60" Margin="5"/>

        <StackPanel Orientation="Vertical" Grid.Column="1">
            <StackPanel  VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock FontSize="16" Text="No. "/>

                <TextBlock Text="{Binding ElementName=Fitxa, Path=ThePokemon.PokId, FallbackValue=4}" 
                         FontSize="16"/>
                <TextBlock Text="{Binding ElementName=Fitxa, Path=ThePokemon.PokName, FallbackValue=Charmander}" 
                        FontWeight="Bold" FontSize="16" Margin="20,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" x:Name="stkTypes" Margin="0,10,0,0"/>


        </StackPanel>
    </Grid>
</UserControl>
