<UserControl x:Class="PokeUI.UserControls.SlidingStatBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PokeUI.UserControls"
             mc:Ignorable="d" 
             x:Name="SlidingBar"
             Loaded="SlidingBar_Loaded"
             d:DesignHeight="70" d:DesignWidth="350">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="255"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding ElementName=Stat, Path=StatText}" 
               Width="60" FontWeight="Bold" VerticalAlignment="Center"
           Grid.Column="0"/>

        <TextBlock Text="{Binding ElementName=Stat, Path=Valor}"
   Foreground="LightGray" Grid.Column="1" Margin="35,0,0,0" VerticalAlignment="Center"></TextBlock>

        <Slider  x:Name="sld" Maximum="255" Minimum="0" 
                 Height="20" Width="200"
                 Foreground="Green"
                 ValueChanged="sld_ValueChanged"
                 Grid.Column="2"/>
    </Grid>
</UserControl>
