<Page x:Class="PokeUI.Pagines.PaginaEdicio"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PokeUI.Pagines" xmlns:uc="clr-namespace:PokeUI.UserControls"
      mc:Ignorable="d" 
      x:Name="Page"
      Loaded="Page_Loaded"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PaginaEdicio">

    <Page.Resources>
        <DataTemplate x:Key="PlantillaComboBox">
            <Border Background="{Binding Color}" Padding="5" CornerRadius="4" Margin="2">
                <TextBlock Text="{Binding TypeName}" 
                Foreground="White" 
                FontWeight="Bold" 
                HorizontalAlignment="Center"/>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="grdMainStructure" Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!--Esquerra-->
        <Grid x:Name="grdEsquerra" Grid.Column="0" Background="White" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <!--Subgrid-->
            <Grid Grid.Row="1" Margin="10" x:Name="grdAtributs">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>


                <TextBlock Margin="5,5,0,0" Text="Height: " FontWeight="SemiBold" Grid.Column="0" Grid.Row="0"/>
                <TextBox Margin="5,5,0,0"  Grid.Column="1" Grid.Row="0" Text="{Binding ElementName=Page, Path=ThePokemon.PokHeight}"/>
                <TextBlock Margin="5,5,0,0" Text="m" FontWeight="SemiBold" Grid.Column="2" Grid.Row="0"/>


                <TextBlock Margin="5,0,0,0" Text="Weight: " FontWeight="SemiBold" Grid.Column="0" Grid.Row="1"/>
                <TextBox Margin="5,0,0,0" Grid.Column="1" Grid.Row="1" Text="{Binding ElementName=Page, Path=ThePokemon.PokWeight}"/>
                <TextBlock Margin="5,5,0,0" Text="kg" FontWeight="SemiBold" Grid.Column="2" Grid.Row="1"/>


                <TextBlock Margin="5,0,0,0" Text="Base Experience: " FontWeight="SemiBold" Grid.Column="0" Grid.Row="2"/>
                <TextBox Margin="5,0,0,0" Grid.Column="1" Grid.Row="2" Text="{Binding ElementName=Page, Path=ThePokemon.PokBaseExperience}"/>


                <TextBlock Margin="5,0,0,0" Text="Image: " FontWeight="SemiBold" Grid.Column="0" Grid.Row="3"/>
                <TextBox Margin="5,5,0,5" Grid.ColumnSpan="3" Grid.Row="4" Text="{Binding ElementName=Page, Path=ThePokemon.PokImage, UpdateSourceTrigger=PropertyChanged}"/>


                <TextBlock Grid.Column="0" Grid.Row="5" Text="Type: " FontWeight="SemiBold" Margin="5,0,0,0"/>

                <StackPanel x:Name="stpTipos" 
                        Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" 
                        Orientation="Horizontal" 
                        Margin="0,0,0,5"/>

                <TextBlock  Grid.Column="0" Grid.Row="6" Text="Abilities: " FontWeight="SemiBold" Margin="5,0,0,0"/>


            </Grid>

            <!--PkmName here-->
            <Border Background="DarkGreen" Padding="10" Grid.ColumnSpan="2" Margin="0,5,10,5" BorderThickness="5" BorderBrush="Green">
                <StackPanel Orientation="Horizontal">

                    <Image Source="/Imatges/pokeball.png" Width="20" Height="20" Margin="10,0,10,0"></Image>
                    <TextBlock Text="{Binding ElementName=Page, Path=ThePokemon.PokName, FallbackValue=Charmander}" 
                               Foreground="White" FontSize="24" FontWeight="Bold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Grid.Row="1" BorderBrush="Gray" BorderThickness="2" Background="white" MaxHeight="300" Margin="10">
                <Image  Source="{Binding ElementName=Page, Path=ThePokemon.PokImage}" Stretch="Uniform"></Image>
            </Border>

            <!--UC-->
            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                <Border Background="DarkGreen" Padding="10" Margin="0,5,50,5">
                    <TextBlock Text="Defense Modifiers" 
                        Foreground="White" FontSize="16" FontWeight="Bold"/>
                </Border>
                <uc:DefenseModifiers x:Name="ucDfModif" ThePokemon="{Binding ElementName=Page, Path=ThePokemon}" Margin="5,0,20,0"></uc:DefenseModifiers>
            </StackPanel>

        </Grid>
        <!--Dreta-->
        <Grid x:Name="grdDreta" Grid.Column="1" Background="LightGreen">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="10">
                <uc:SlidingStatBar StatText="HP:"      Margin="0,2,0,0" Valor="{Binding ElementName=Page, Path=ThePokemon.BaseStat.BHp}"/>
                <uc:SlidingStatBar StatText="Attack:"  Margin="0,2,0,0" Valor="{Binding ElementName=Page, Path=ThePokemon.BaseStat.BAtk}"/>
                <uc:SlidingStatBar StatText="Defense:" Margin="0,2,0,0" Valor="{Binding ElementName=Page, Path=ThePokemon.BaseStat.BDef}"/>
                <uc:SlidingStatBar StatText="SpAtk:"   Margin="0,2,0,0" Valor="{Binding ElementName=Page, Path=ThePokemon.BaseStat.BSpAtk}"/>
                <uc:SlidingStatBar StatText="SpDef:"   Margin="0,2,0,0" Valor="{Binding ElementName=Page, Path=ThePokemon.BaseStat.BSpDef}"/>
                <uc:SlidingStatBar StatText="Speed;"   Margin="0,2,0,0" Valor="{Binding ElementName=Page, Path=ThePokemon.BaseStat.BSpeed}"/>
            </StackPanel>

            <!--Evolutions-->
            <StackPanel Grid.Row="1" Margin="10,0,10,10">
                <Border Background="DarkGreen" Padding="10" Margin="50,0,0,5" >
                    <TextBlock Text="Evolutions" 
                        Foreground="White" FontSize="16" FontWeight="Bold"/>
                </Border>

                <Grid Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Nom/codi: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>

                    <ComboBox x:Name="cmbEvoSearch" 
                          Grid.Column="1"
                          IsEditable="True"
                          DisplayMemberPath="PokName"
                          Height="25"/>

                    <Button x:Name="btnAddEvo" Click="btnAddEvo_Click"
                            Grid.Column="2" 
                            Content="+" 
                            FontWeight="Bold" 
                            Foreground="White"
                            Background="#87CEFA" 
                            BorderThickness="0"
                            Width="25" Height="25"
                            Margin="5,0,0,0"
                            Style="{StaticResource RoundAddButtonStyle}"/>  
                </Grid>

                <ListBox x:Name="lstEvoluciones" 
         Height="150" 
         BorderBrush="Gray" 
         BorderThickness="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#EEE" CornerRadius="3" Padding="5,2" Margin="0,0,10,0">
                                    <TextBlock FontWeight="Bold" Foreground="DarkGreen">
                        <Run Text="Stage "/>
                        <Run Text="{Binding Stage}"/>
                                    </TextBlock>
                                </Border>

                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14">
                    <Run Text="{Binding Pokemon.PokId, Mode=OneWay, StringFormat='#{0}'}"/>
                    <Run Text=" - "/>
                    <Run Text="{Binding Pokemon.PokName, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <UniformGrid Rows="1" Background="DarkGreen">
                    <Button x:Name="btnDeleteEvo" Click="btnDelEvo_Click" Background="Transparent" BorderThickness="0" Foreground="White" Padding="5">
                        <TextBlock Text="✕" FontWeight="Bold" FontSize="14"/>
                    </Button>
                    <Button x:Name="btnUpEvo" Click="btnUpEvo_Click" Background="Transparent" BorderThickness="0" Foreground="White" Padding="5">
                        <TextBlock Text="↑" FontWeight="Bold" FontSize="14"/>
                    </Button>
                    <Button x:Name="btnDownEvo" Click="btnDownEvo_Click" Background="Transparent" BorderThickness="0" Foreground="White" Padding="5">
                        <TextBlock Text="↓" FontWeight="Bold" FontSize="14"/>
                    </Button>
                </UniformGrid>
            </StackPanel>

        </Grid>

    </Grid>
</Page>
