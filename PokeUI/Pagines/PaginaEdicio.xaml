<Page x:Class="PokeUI.Pagines.PaginaEdicio"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PokeUI.Pagines" 
      xmlns:uc="clr-namespace:PokeUI.UserControls"
      xmlns:dotNetKitControls="clr-namespace:DotNetKit.Windows.Controls;assembly=DotNetKit.Wpf.AutoCompleteComboBox"
      xmlns:utils="clr-namespace:PokeUI.Utils"
      mc:Ignorable="d" 
      x:Name="Page"
      Loaded="Page_Loaded"
      d:DesignHeight="650" d:DesignWidth="1000"
      Title="PaginaEdicio">

    <ScrollViewer>
        <Grid x:Name="grdMainStructure" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="DarkGreen" Grid.ColumnSpan="2" Height="50">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource TransparentBackgroundButton}" Margin="20,0,20,0"  x:Name="btnBack" Click="btnBack_Click" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets"></Button>
                        <!--<Button Style="{StaticResource TransparentBackgroundButton}" Margin="20,0,20,0" x:Name="btnEdit" Click="btnEdit_Click" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets"></Button>
                        <Button Style="{StaticResource TransparentBackgroundButton}" Margin="20,0,20,0"  x:Name="btnCancel" Click="btnCancel_Click" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"></Button>-->

                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                        <Button Style="{StaticResource TransparentBackgroundButton}"  Margin="20,0,20,0" Content="&#xE74E;" Click="btnSave_Click" x:Name="btnSave" FontFamily="Segoe MDL2 Assets"></Button>
                        <!--<Button Style="{StaticResource TransparentBackgroundButton}"  Margin="20,0,20,0" Content="&#xE948;" Click="btnAdd_Click" x:Name="btnAdd" FontFamily="Segoe MDL2 Assets"></Button>-->

                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="grdEsquerra" Grid.Column="0" Grid.Row="1" Background="White" Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Border Background="DarkGreen" Padding="10" Grid.ColumnSpan="2" Margin="0,5,10,5" BorderThickness="5" BorderBrush="Green">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Imatges/pokeball.png" Width="20" Height="20" Margin="10,0,10,0"/>

                        <TextBox Text="{Binding ElementName=Page, Path=ThePokemon.PokName, UpdateSourceTrigger=PropertyChanged}" 
                             Foreground="White" 
                             FontSize="24" 
                             FontWeight="Bold"
                             Background="Transparent" 
                             BorderThickness="0"
                             CaretBrush="White" 
                             MinWidth="200"
                             TextChanged="ValidarText_Changed"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Grid.Row="1" BorderBrush="Gray" BorderThickness="2" Background="White" MaxHeight="300" Margin="10">
                    <Image Source="{Binding ElementName=Page, Path=ThePokemon.PokImage}" Stretch="Uniform"/>
                </Border>

                <Grid Grid.Row="1" Margin="10" x:Name="grdAtributs">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Margin="5,5,0,0" Text="Height: " FontWeight="SemiBold" Grid.Column="0" Grid.Row="0"/>
                    <TextBox Margin="5,5,0,0" Grid.Column="1" Grid.Row="0" 
                         Text="{Binding ElementName=Page, Path=ThePokemon.PokHeight, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalConv}}" 
                         TextChanged="ValidarText_Changed"/>
                    <TextBlock Margin="5,5,0,0" Text="m" FontWeight="SemiBold" Grid.Column="2" Grid.Row="0"/>

                    <TextBlock Margin="5,5,0,0" Text="Weight: " FontWeight="SemiBold" Grid.Column="0" Grid.Row="1"/>
                    <TextBox Margin="5,5,0,0" Grid.Column="1" Grid.Row="1" 
                         Text="{Binding ElementName=Page, Path=ThePokemon.PokWeight, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalConv}}" 
                         TextChanged="ValidarText_Changed"/>
                    <TextBlock Margin="5,5,0,0" Text="kg" FontWeight="SemiBold" Grid.Column="2" Grid.Row="1"/>

                    <TextBlock Margin="5,5,0,0" Text="Base Exp: " FontWeight="SemiBold" Grid.Column="0" Grid.Row="2"/>
                    <TextBox Margin="5,5,0,0" Grid.Column="1" Grid.Row="2" Text="{Binding ElementName=Page, Path=ThePokemon.PokBaseExperience, UpdateSourceTrigger=PropertyChanged}" TextChanged="ValidarText_Changed"/>

                    <TextBlock Margin="5,5,0,0" Text="Image URL: " FontWeight="SemiBold" Grid.Column="0" Grid.Row="3"/>
                    <TextBox Margin="5,5,0,15" Grid.ColumnSpan="3" Grid.Row="4" Text="{Binding ElementName=Page, Path=ThePokemon.PokImage, UpdateSourceTrigger=PropertyChanged}" TextChanged="ValidarText_Changed"/>

                    <TextBlock Grid.Column="0" Grid.Row="5" Text="Type: " FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" 
            Orientation="Horizontal" Margin="0,0,0,15">

                        <ComboBox x:Name="cmbType1" Width="100" Margin="0,0,5,0"
                            SelectedItem="{Binding ElementName=Page, Path=SelectedType1, Mode=TwoWay}"
                            ItemContainerStyle="{StaticResource FullWidthComboBoxItem}"
                            ItemTemplate="{StaticResource PlantillaComboBox}"
                            TextSearch.TextPath="TypeName"/>

                        <ComboBox x:Name="cmbType2" Width="100" Margin="0,0,5,0"
                            SelectedItem="{Binding ElementName=Page, Path=SelectedType2, Mode=TwoWay}"
                            ItemContainerStyle="{StaticResource FullWidthComboBoxItem}"
                            ItemTemplate="{StaticResource PlantillaComboBox}"
                            TextSearch.TextPath="TypeName"/>
                    </StackPanel>


                    <TextBlock Grid.Column="0" Grid.Row="6" Text="Abilities: " FontWeight="SemiBold" Margin="5,5,0,0" VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="6" Margin="0,5,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <dotNetKitControls:AutoCompleteComboBox x:Name="cmbAbilitySearch"
                                                  Grid.Column="0"
                                                  DisplayMemberPath="AbilName" 
                                                  TextSearch.TextPath="AbilName" 
                                                  IsEditable="True"
                                                  Height="25"/>

                            <Button x:Name="btnAddAbility" Click="btnAddAbility_Click"
                                Grid.Column="1"
                                Content="+" 
                                Width="25" Height="25"
                                Margin="5,0,0,0"
                                Style="{StaticResource RoundAddButtonStyle}"/>
                        </Grid>

                        <ItemsControl x:Name="lstAbilities" Margin="0,5,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#EEE" CornerRadius="10" Padding="8,2" Margin="0,2,5,2" BorderBrush="#CCC" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Abil.AbilName}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#333"/>
                                            <Button Click="btnRemoveAbility_Click" 
                                                Content="✕"
                                                Background="Transparent" BorderThickness="0" 
                                                Foreground="Red" FontWeight="Bold"
                                                Margin="5,0,0,0" Cursor="Hand" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                    <Border Background="DarkGreen" Padding="10" Margin="0,5,50,5">
                        <TextBlock Text="Damage Modifiers" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </Border>
                    <uc:DefenseModifiers x:Name="ucDfModif" ThePokemon="{Binding ElementName=Page, Path=ThePokemon}" Margin="5,0,20,0"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="grdDreta" Grid.Column="1" Grid.Row="1" Background="LightGreen">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="10">
                    <uc:SlidingStatBar StatText="HP:"      Margin="0,2,0,0" Valor="{Binding ElementName=Page, Path=ThePokemon.BaseStat.BHp, Mode=TwoWay}"/>
                    <uc:SlidingStatBar StatText="Attack:"  Margin="0,2,0,0" Valor="{Binding ElementName=Page, Path=ThePokemon.BaseStat.BAtk, Mode=TwoWay}"/>
                    <uc:SlidingStatBar StatText="Defense:" Margin="0,2,0,0" Valor="{Binding ElementName=Page, Path=ThePokemon.BaseStat.BDef, Mode=TwoWay}"/>
                    <uc:SlidingStatBar StatText="SpAtk:"   Margin="0,2,0,0" Valor="{Binding ElementName=Page, Path=ThePokemon.BaseStat.BSpAtk, Mode=TwoWay}"/>
                    <uc:SlidingStatBar StatText="SpDef:"   Margin="0,2,0,0" Valor="{Binding ElementName=Page, Path=ThePokemon.BaseStat.BSpDef, Mode=TwoWay}"/>
                    <uc:SlidingStatBar StatText="Speed:"   Margin="0,2,0,0" Valor="{Binding ElementName=Page, Path=ThePokemon.BaseStat.BSpeed, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="10,0,10,10">
                    <Border Background="DarkGreen" Padding="10" Margin="50,0,0,5" >
                        <TextBlock Text="Evolutions" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </Border>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Nom/codi: " VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,5,0"/>

                        <ComboBox x:Name="cmbEvoSearch" 
                              Grid.Column="1"
                              IsEditable="True"
                              DisplayMemberPath="PokName"
                              Height="25"/>

                        <Button x:Name="btnAddEvo" Click="btnAddEvo_Click"
                            Grid.Column="2" 
                            Content="+" 
                            Width="25" Height="25"
                            Margin="5,0,0,0"
                            Style="{StaticResource RoundAddButtonStyle}"/>
                    </Grid>

                    <ListBox x:Name="lstEvoluciones" Height="200" BorderBrush="Gray" BorderThickness="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#EEE" CornerRadius="3" Padding="5,2" Margin="0,0,10,0">
                                        <TextBlock FontWeight="Bold" Foreground="DarkGreen">
                                        <Run Text="Stage "/>
                                        <Run Text="{Binding Stage}"/>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14">
                                    <Run Text="{Binding Pokemon.PokId, Mode=OneWay, StringFormat='#{0}'}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding Pokemon.PokName, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <UniformGrid Rows="1" Background="DarkGreen">
                        <Button x:Name="btnDeleteEvo" Click="btnDelEvo_Click" Background="Transparent" BorderThickness="0" Foreground="White" Padding="5">
                            <TextBlock Text="✕" FontWeight="Bold" FontSize="14"/>
                        </Button>
                        <Button x:Name="btnUpEvo" Click="btnUpEvo_Click" Background="Transparent" BorderThickness="0" Foreground="White" Padding="5">
                            <TextBlock Text="↑" FontWeight="Bold" FontSize="14"/>
                        </Button>
                        <Button x:Name="btnDownEvo" Click="btnDownEvo_Click" Background="Transparent" BorderThickness="0" Foreground="White" Padding="5">
                            <TextBlock Text="↓" FontWeight="Bold" FontSize="14"/>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>

</Page>