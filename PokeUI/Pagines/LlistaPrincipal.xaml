<Page x:Class="PokeUI.Pagines.LlistaPrincipal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PokeUI.Pagines"
      xmlns:uc="clr-namespace:PokeUI.UserControls"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="Page_Loaded"
      Background="White"
      Title="LlistaPrincipal">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Image Source="/Imatges/Ball-Pokedex.png" Height="50"></Image>
        <StackPanel Orientation="Horizontal" x:Name="stpFiltres" Grid.Column="1">
            <TextBox Width="150" Margin="10"></TextBox>
            <ComboBox x:Name="cmbTipus" Margin="10"/>
            <Button x:Name="btnNetejaFiltres"  Click="btnNetejaFiltres_Click" Style="{StaticResource PokedexButtonStyle}">Neteja</Button>
        </StackPanel>
        <ListView x:Name="lsvPokedex" Grid.Row="2" HorizontalContentAlignment="Stretch" SelectionChanged="lsvPokedex_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <uc:FitxaReduida ThePokemon="{Binding}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <uc:FitxaCompleta x:Name="MasterDetail" 
                  Grid.Column="1" 
                  Grid.Row="1"
                  ThePokemon="{Binding ElementName=lsvPokedex, Path=SelectedItem}" />
    </Grid>
</Page>
