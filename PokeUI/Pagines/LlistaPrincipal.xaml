<Page x:Class="PokeUI.Pagines.LlistaPrincipal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PokeUI.Pagines"
      xmlns:uc="clr-namespace:PokeUI.UserControls" 
      xmlns:ut="clr-namespace:PokeUI.Utils"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="Page_Loaded"
      Background="White"
      Title="LlistaPrincipal">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="DarkGreen" Grid.ColumnSpan="2" Height="50">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <!--<Button Style="{StaticResource TransparentBackgroundButton}" Margin="20,0,20,0"  x:Name="btnBack" Click="btnBack_Click" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets"></Button>-->
                    <Button Style="{StaticResource TransparentBackgroundButton}" Margin="20,0,20,0" x:Name="btnEdit" Click="btnEdit_Click" Content="&#xE70F;" FontFamily="Segoe MDL2 Assets"></Button>
                    <Button Style="{StaticResource TransparentBackgroundButton}" Margin="20,0,20,0"  x:Name="btnCancel" Click="btnCancel_Click" Content="&#xE711;" FontFamily="Segoe MDL2 Assets"></Button>

                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
                    <!--<Button Style="{StaticResource TransparentBackgroundButton}"  Margin="20,0,20,0" Content="&#xE74E;" Click="btnSave_Click" x:Name="btnSave" FontFamily="Segoe MDL2 Assets"></Button>-->
                    <Button Style="{StaticResource TransparentBackgroundButton}"  Margin="20,0,20,0" Content="&#xE948;" Click="btnAdd_Click" x:Name="btnAdd" FontFamily="Segoe MDL2 Assets"></Button>

                </StackPanel>
            </Grid>
        </Border>
        
        <Image Source="/Imatges/Ball-Pokedex.png" Height="50" Grid.Row="1"></Image>
        <StackPanel Orientation="Horizontal" x:Name="stpFiltres" Grid.Column="1" Grid.Row="1">
            <AdornerDecorator>
                <TextBox x:Name="txbFiltreNom" Width="150" Margin="10" TextChanged="TextBox_TextChanged" Padding="5" >
                    <ut:WatermarkService.Watermark>
                        <TextBlock>Nom o codi</TextBlock>
                    </ut:WatermarkService.Watermark>
                </TextBox>
            </AdornerDecorator>
            <!-- El ComboBox NO debe estar dentro de un AdornerDecorator -->
            <ComboBox x:Name="cmbTipus" 
          Margin="10" 
          Width="150" 
          SelectionChanged="cmbTipus_SelectionChanged">

                <ut:WatermarkService.Watermark>
                    <TextBlock>Selecciona tipus</TextBlock>
                </ut:WatermarkService.Watermark>

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Color}" Padding="5" CornerRadius="4" Margin="2">
                            <TextBlock Text="{Binding TypeName}" 
                           Foreground="White" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"/>
                        </Border>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

            </ComboBox>
            <Button x:Name="btnNetejaFiltres"  Click="btnNetejaFiltres_Click" Style="{StaticResource PokedexButtonStyle}">Neteja</Button>
        </StackPanel>
        <ListView x:Name="lsvPokedex" Grid.Row="2" HorizontalContentAlignment="Stretch" SelectionChanged="lsvPokedex_SelectionChanged" MouseDoubleClick="lsvPokedex_MouseDoubleClick">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <uc:FitxaReduida ThePokemon="{Binding}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <uc:FitxaCompleta x:Name="MasterDetail" 
                  Grid.Column="1" 
                  Grid.Row="2"
                  ThePokemon="{Binding ElementName=lsvPokedex, Path=SelectedItem}" />
    </Grid>
</Page>
